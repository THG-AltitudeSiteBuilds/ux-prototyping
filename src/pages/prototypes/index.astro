---
import ReportLayout from '@/components/ReportLayout.astro';

// Add an entry here for every standalone HTML prototype. The `slug` is the
// filename (without .html) of a raw HTML file sitting next to this one in
// src/pages/prototypes/ — Astro serves those as routes off the SSR worker.
//
// Do NOT put prototypes in public/assets/: the /assets/ static route on the
// deployed site currently returns 500 for every file under it.
const prototypes = [
  {
    title: 'MyProtein Checkout',
    desc: 'Mobile checkout prototype — guest and logged-in journeys, delivery vs click & collect, Premier/MyDemand delivery promo variants, and the payment method flows.',
    slug: 'myprotein-checkout',
    date: '14 August 2026',
    tags: ['Checkout', 'Mobile'],
  }
];
---

<ReportLayout title="Prototypes">

  <section class="proto-intro">
    <p class="proto-eyebrow">For the Myprotein design team</p>
    <h1 class="proto-h1">Prototypes</h1>
    <p class="proto-lead">
      Interactive, self-contained prototypes. Each one opens in a new tab as a
      standalone page — click through it exactly as a user would.
    </p>
  </section>

  <div class="proto-list">
    {prototypes.map((proto) => (
      <a
        href={`/prototypes/${proto.slug}`}
        class="proto-card"
        target="_blank"
        rel="noopener"
      >
        <div class="proto-card-head">
          <h2 class="proto-title">{proto.title}</h2>
          <span class="proto-date">{proto.date}</span>
        </div>
        <p class="proto-desc">{proto.desc}</p>
        <div class="proto-foot">
          <div class="proto-tags">
            {proto.tags.map((tag) => (
              <span class="proto-tag">{tag}</span>
            ))}
          </div>
          <span class="proto-cta">Open prototype ↗</span>
        </div>
      </a>
    ))}
  </div>

</ReportLayout>

<style>
  .proto-intro { margin-bottom: 40px; }
  .proto-eyebrow {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    opacity: 0.5;
    margin-bottom: 10px;
  }
  .proto-h1 {
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 800;
    color: var(--color-text-heading);
    margin-bottom: 16px;
    line-height: 1.15;
  }
  .proto-lead {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-text-body);
    max-width: 680px;
  }

  .proto-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 680px;
  }
  .proto-card {
    display: block;
    background: var(--color-bg-card);
    border: var(--card-border);
    border-radius: var(--radius-card);
    padding: 20px 22px;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.1s;
  }
  .proto-card:hover {
    border-color: rgba(0,57,66,0.3);
    box-shadow: var(--card-shadow);
    transform: translateY(-1px);
  }
  .proto-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 6px;
  }
  .proto-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text-heading);
  }
  .proto-date {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--color-text-body);
    opacity: 0.6;
  }
  .proto-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-body);
    margin-bottom: 14px;
  }
  .proto-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .proto-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .proto-tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-bg-muted);
    border-radius: var(--radius-chip);
    padding: 3px 10px;
  }
  .proto-cta {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
